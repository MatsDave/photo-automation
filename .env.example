# Copy this file to .env. Never commit .env or share its values.
INSTAGRAM_APP_ID=replace-with-the-instagram-app-id-shown-in-meta
INSTAGRAM_APP_SECRET=replace-with-the-instagram-app-secret
# This must be the exact public HTTPS callback URL saved in the Meta dashboard.
INSTAGRAM_REDIRECT_URI=https://replace-with-your-public-domain/auth/instagram/callback

# Generate each with the commands in README.md.
SESSION_SECRET=replace-with-a-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Facebook Login for Business / Facebook Page connection
FACEBOOK_APP_ID=replace-with-your-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-your-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://replace-with-your-public-domain/auth/facebook/callback

# Create a separate Meta app with the Threads use case, then set these values.
THREADS_APP_ID=replace-with-your-threads-app-id
THREADS_APP_SECRET=replace-with-your-threads-app-secret
THREADS_REDIRECT_URI=https://replace-with-your-public-domain/auth/threads/callback

# Telegram-to-Instagram workflow
TELEGRAM_BOT_TOKEN=replace-with-your-existing-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
AUTHORIZED_TELEGRAM_USER_ID=replace-with-your-numeric-telegram-user-id
GEMINI_API_KEY=replace-with-your-Google-AI-Studio-api-key
GEMINI_MODEL=gemini-3.6-flash
PUBLIC_BASE_URL=https://replace-with-your-public-domain
DATA_DIR=data
# On Render Free, paste the contents of data/*_token.enc here in the
# dashboard only. Use the matching TOKEN_ENCRYPTION_KEY. Never commit the value.
INSTAGRAM_TOKEN_ENCRYPTED=
FACEBOOK_TOKEN_ENCRYPTED=
THREADS_TOKEN_ENCRYPTED=

